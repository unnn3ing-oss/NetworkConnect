{
  "name": "networkconnect",
  "version": "0.1.0",
  "description": "家用網路設備主控台（桌面 App 內建伺服器）",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "config": {
    "go2rtcVersion": "1.9.14"
  },
  "scripts": {
    "start": "node server/cli.js",
    "dev": "node --watch server/cli.js",
    "dev:mock": "node --watch server/cli.js --mock",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/unit/ui/*.test.mjs\" \"test/contract/**/*.test.js\"",
    "test:e2e": "playwright test --config=test/e2e/playwright.config.js",
    "desktop": "electron .",
    "fetch:go2rtc": "node scripts/fetch-go2rtc.js",
    "icons": "node scripts/make-icons.js",
    "dist:mac": "node scripts/fetch-go2rtc.js --target darwin-arm64 && electron-builder --mac dmg --arm64 --publish never",
    "dist:win": "node scripts/fetch-go2rtc.js --target win32-x64 && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "playwright test --config=test/desktop/playwright.config.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "ajv": "8.20.0",
    "fastify": "5.12.7",
    "nanoid": "6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1"
  }
}

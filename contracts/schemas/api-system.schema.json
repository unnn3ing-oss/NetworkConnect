{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://networkconnect.local/schemas/api-system.schema.json",
  "title": "system 模組 API",
  "$defs": {
    "Health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "version", "uptime"],
      "properties": {
        "ok": { "const": true },
        "version": { "type": "string", "description": "package.json 的 version", "examples": ["0.1.0"] },
        "uptime": { "type": "number", "minimum": 0, "description": "伺服器已執行秒數", "examples": [12.5] }
      }
    },
    "ModuleState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state"],
      "properties": {
        "name": { "type": "string", "examples": ["inventory"] },
        "state": { "type": "string", "enum": ["ok", "failed", "disabled"] },
        "error": { "type": "string", "description": "state=failed 時的原因" }
      }
    },
    "ModuleList": { "type": "array", "items": { "$ref": "#/$defs/ModuleState" } }
  }
}
